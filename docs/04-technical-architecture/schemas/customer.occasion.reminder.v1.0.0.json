{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer Occasion Reminder Event",
  "type": "object",
  "required": [
    "message_id",
    "topic",
    "message_type",
    "schema_version",
    "session_id",
    "correlation_id",
    "source",
    "context_version",
    "publication_time",
    "security_context",
    "payload",
    "outcome"
  ],
  "properties": {
    "message_id": { "type": "string" },
    "topic": { "type": "string", "const": "customer.occasion.reminder" },
    "message_type": { "type": "string", "const": "event" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "session_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "source": { "type": "string", "const": "crm" },
    "context_version": { "type": "integer", "minimum": 0 },
    "publication_time": { "type": "string", "format": "date-time" },
    "security_context": {
      "type": "object",
      "required": ["classification", "subject_reference"],
      "properties": {
        "classification": { "type": "string", "const": "confidential" },
        "subject_reference": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "browser_hash",
        "occasion_type",
        "days_until_event",
        "recipient_relation"
      ],
      "properties": {
        "browser_hash": { "type": "string" },
        "occasion_type": { "type": "string" },
        "days_until_event": { "type": "integer" },
        "recipient_relation": { "type": "string" }
      }
    },
    "outcome": { "type": "object" }
  }
}
