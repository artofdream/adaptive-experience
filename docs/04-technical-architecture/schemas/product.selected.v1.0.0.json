{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlab.com/artof-group/adaptive-experience-architecture/-/blob/main/docs/04-technical-architecture/schemas/product.selected.v1.0.0.json",
  "title": "product.selected",
  "description": "Minimum payload contract for product.selected (NFR-015/017). Envelope fields live in the bus envelope, not this payload schema.",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "options": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "card_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "flower_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "colour": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "ribbon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "product_id"
  ],
  "additionalProperties": false
}
