# 24/7 Autonomous Cloud Agent Container Specification
FROM python:3.12-slim

# Install system dependencies & glab CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    glab \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt fastapi uvicorn requests pydantic

# Copy codebase
COPY . .

# Set environment defaults
ENV PYTHONUNBUFFERED=1 \
    AEA_AUTONOMOUS_LOOP_ENABLED=true \
    AEA_AGENT_PORT=8080

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "platform.aea_platform.agent_gateway:app", "--host", "0.0.0.0", "--port", "8080"]
