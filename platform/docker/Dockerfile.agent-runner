# 24/7 Autonomous Cloud Agent Container Specification
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

# Install system dependencies & glab CLI via apt-get
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    glab \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install python dependencies directly
RUN pip install --no-cache-dir fastapi uvicorn requests pydantic prometheus-fastapi-instrumentator

# Copy codebase
COPY . .

# Set environment defaults
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/platform \
    AEA_AUTONOMOUS_LOOP_ENABLED=true \
    AEA_AGENT_PORT=8080

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "aea_platform.agent_gateway:app", "--host", "0.0.0.0", "--port", "8080"]
