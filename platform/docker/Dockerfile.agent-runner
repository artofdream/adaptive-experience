# 24/7 Autonomous Cloud Agent Container Specification
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

# #432: keep the digest-pinned python:3.12-slim (Debian 13 / trixie) base;
# rebuild so gzip, libpcre2-8-0, and libsqlite3-0 are the Debian security
# revisions from Trivy (!510 image-scan High):
#   gzip=1.13-1+deb13u1              (CVE-2026-41992)
#   libpcre2-8-0=10.46-1~deb13u2    (CVE-2026-86145 / CVE-2026-89161)
#   libsqlite3-0=3.46.1-7+deb13u2   (CVE-2026-11822 / CVE-2026-11824)
# Same class of gate as orchestration libpcre2 and #409 gateway libexpat —
# fix the packages in-image, do not widen image-scan-exceptions.json.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        glab \
        gzip=1.13-1+deb13u1 \
        "libpcre2-8-0=10.46-1~deb13u2" \
        libsqlite3-0=3.46.1-7+deb13u2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install python dependencies directly
RUN pip install --no-cache-dir fastapi uvicorn requests pydantic prometheus-fastapi-instrumentator

# Copy codebase
COPY . .

# Set environment defaults
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/platform \
    AEA_AUTONOMOUS_LOOP_ENABLED=true \
    AEA_AGENT_PORT=8080

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "aea_platform.agent_gateway:app", "--host", "0.0.0.0", "--port", "8080"]
