# Live LLM intent path (platform/aea_platform/internal_runtime.py)
#
# All three of AEA_AI_ENDPOINT / AEA_AI_API_KEY / AEA_AI_MODEL must be set
# together or the process fails closed at start (partial env is rejected).
# Leave all three unset/commented to run on ReferenceIntentInterpreter
# (regex fallback) — that is a supported, honest mode, not a broken one.
#
# Copy this file to platform/.env, fill in real values, and never commit
# that file (.env is git-ignored). There is no Python dotenv loader;
# host uvicorn reads os.environ only. Compose interpolates from this file
# when you pass --env-file platform/.env.

# Anthropic console key for the LiteLLM container only (not AEA_AI_API_KEY):
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Local LiteLLM master key (fixture). Orchestration sends this as
# Authorization: Bearer. Do not put the Anthropic key here.
LITELLM_MASTER_KEY=sk-aea-local-dev

# Full OpenAI-compatible chat completions POST URL, used as-is (nothing appended).
# Host uvicorn + published LiteLLM port:
AEA_AI_ENDPOINT=http://localhost:4000/v1/chat/completions
# Edge Compose overlay sets http://litellm:4000/v1/chat/completions instead.
# localhost:4000 from inside the orchestration container will not reach LiteLLM.

# Must match LITELLM_MASTER_KEY when using the local proxy.
AEA_AI_API_KEY=sk-aea-local-dev

# Must match a model_name in edge/litellm.yaml (default claude-sonnet-5).
# claude-opus-5 is a valid Anthropic id but thinking-on-by-default often
# misses the interpreter's 2.5s budget and opens the circuit.
AEA_AI_MODEL=claude-sonnet-5

# Optional. Request timeout in seconds; internal_runtime.py caps effective
# use at <=2.5s per the intent interpreter's own budget.
AEA_AI_TIMEOUT=2.0

# Required regardless of the AI path (platform/aea_platform/internal_runtime.py).
# Served via uvicorn on port 8081 (see platform/Dockerfile.orchestration).
# GET /internal/v1/ai/health also requires Authorization: Bearer
# $AEA_ORCHESTRATION_TOKEN and an x-subject-reference header (any non-empty value).
# Edge Compose does not publish 8081; health-check from the host with
# docker compose exec (see edge/README.md).
AEA_POSTGRES_DSN=postgresql://aea_migration:local-migration-only@localhost:5432/adaptive_experience
AEA_ORCHESTRATION_TOKEN=
