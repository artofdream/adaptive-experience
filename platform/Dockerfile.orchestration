FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254

WORKDIR /app
# slim (not alpine): confluent-kafka publishes manylinux wheels; alpine Path B
# relay/consumer crash-looped with ModuleNotFoundError: confluent_kafka.
COPY platform/requirements.txt platform/requirements.lock /tmp/platform/
COPY edge/requirements.txt edge/requirements.lock /tmp/edge/
RUN pip install --no-cache-dir \
    -r /tmp/platform/requirements.txt -c /tmp/platform/requirements.lock \
    -r /tmp/edge/requirements.txt -c /tmp/edge/requirements.lock
COPY platform ./platform
ENV PYTHONPATH=/app/platform
USER nobody
CMD ["uvicorn", "aea_platform.internal_runtime:app", "--host", "0.0.0.0", "--port", "8081", "--no-server-header"]
